# Independent application base; prefer cached official Python images.
# Infrastructure services must use existing local images, not another app image.
PYTHON_BASE_IMAGE=python:3.12-slim-bookworm

# Container configuration template; business services are not implemented yet.
# check/db-init do not load secrets. Future api/worker must explicitly inject required fields.
APP_ENV=development
APP_TIMEZONE=Asia/Shanghai
DATABASE_URL=sqlite:////app/data/news_assistant.db

# Selected model provider must support structured tool calling.
LLM_PROVIDER=
LLM_MODEL=
LLM_BASE_URL=
LLM_API_KEY=
NEWS_SEARCH_PROVIDER=
NEWS_SEARCH_API_KEY=

# QQ mailbox SMTP: authorization code, never the QQ account password.
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_USE_SSL=true
SMTP_USERNAME=
SMTP_AUTH_CODE=
SMTP_FROM_NAME=AI News Assistant
SMTP_TIMEOUT_SECONDS=20
MAIL_MAX_ATTEMPTS=3

# Initial adjustable limits, not measured performance guarantees.
AGENT_MAX_MODEL_CALLS=15
AGENT_MAX_TOOL_CALLS=20
AGENT_MAX_SECONDS=180
TOOL_TIMEOUT_SECONDS=15
AGENT_WORKSPACE_ROOT=/app/workspace
SHELL_TOOL_ENABLED=false
