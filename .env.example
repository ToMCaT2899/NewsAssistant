# 使用官方应用基础镜像，不得使用其他项目的应用镜像。
PYTHON_BASE_IMAGE=python:3.12-slim-bookworm
NODE_BASE_IMAGE=node:24-alpine
# 固定本机已有官方 Nginx 1.31.8 镜像的摘要。
NGINX_BASE_IMAGE=nginx@sha256:5ab5b0b01097420873a3f3330f44248e34a3c2a3e8d5ee30658aeae8cb7435da
APP_PORT=8080
APP_ENV=production
DATABASE_URL=sqlite:////app/data/news_assistant.db

# 登录和账号初始化所需配置，请在本机填写，不提交真实值。
JWT_SECRET=
# 用户模型密钥的服务端加密主密钥，生成一次后妥善保留；不可用 JWT_SECRET 替代。
MODEL_ENCRYPTION_KEY=
ADMIN_EMAIL=
ADMIN_PASSWORD=
# 可选的管理员已确认收件地址；留空表示收件地址尚未验证。
VERIFIED_RECIPIENT_EMAIL=

# 以下仅供隔离 CLI 联调；网页用户必须在“模型设置”保存自己的配置，不会回退到这里。
# LLM_BASE_URL 必须包含 API 路径前缀，例如 https://your-provider.example/v1。
LLM_PROVIDER=chat_completions
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=

# 无需搜索 API 密钥：关键词检索仅覆盖此处配置的 RSS 来源。
RSS_SOURCES_JSON={"huggingface":"https://huggingface.co/blog/feed.xml","arxiv-ai":"https://rss.arxiv.org/rss/cs.AI","openai":"https://openai.com/news/rss.xml","techcrunch-ai":"https://techcrunch.com/category/artificial-intelligence/feed/"}

# 始终使用校验证书的 TLS 连接 SMTP（465）；填写授权码而非 QQ 登录密码。
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_USERNAME=
SMTP_AUTH_CODE=
SMTP_FROM_NAME=AI News Assistant
SMTP_TIMEOUT_SECONDS=20
MAIL_MAX_ATTEMPTS=3

AGENT_MAX_MODEL_CALLS=15
AGENT_MAX_TOOL_CALLS=20
AGENT_MAX_SECONDS=180
TOOL_TIMEOUT_SECONDS=15
AGENT_WORKSPACE_ROOT=/app/workspace
SHELL_TOOL_ENABLED=false
WORKER_POLL_SECONDS=30
LEASE_SECONDS=360
