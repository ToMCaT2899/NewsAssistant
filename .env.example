# Official application bases; never use another project's application image.
PYTHON_BASE_IMAGE=python:3.12-slim-bookworm
NODE_BASE_IMAGE=node:24-alpine
# Pinned digest of the existing local official Nginx 1.31.8 image.
NGINX_BASE_IMAGE=nginx@sha256:5ab5b0b01097420873a3f3330f44248e34a3c2a3e8d5ee30658aeae8cb7435da
APP_PORT=8080
APP_ENV=production
DATABASE_URL=sqlite:////app/data/news_assistant.db

# Required for login/bootstrap. Fill locally, never commit actual values.
JWT_SECRET=
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Optional administrator-confirmed recipient; blank means sending stays unverified.
VERIFIED_RECIPIENT_EMAIL=

# Configure a provider supporting chat completions AND tool calling.
# LLM_BASE_URL must include its API prefix, for example https://your-provider.example/v1.
LLM_PROVIDER=chat_completions
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=

# No search API key required: keyword discovery covers these configured RSS sources only.
RSS_SOURCES_JSON={"huggingface":"https://huggingface.co/blog/feed.xml","arxiv-ai":"https://rss.arxiv.org/rss/cs.AI"}

# Always SMTP over verified TLS (465); authorization code, not QQ login password.
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_USERNAME=
SMTP_AUTH_CODE=
SMTP_FROM_NAME=AI News Assistant
SMTP_TIMEOUT_SECONDS=20
MAIL_MAX_ATTEMPTS=3

AGENT_MAX_MODEL_CALLS=15
AGENT_MAX_TOOL_CALLS=20
AGENT_MAX_SECONDS=180
TOOL_TIMEOUT_SECONDS=15
AGENT_WORKSPACE_ROOT=/app/workspace
SHELL_TOOL_ENABLED=false
WORKER_POLL_SECONDS=30
LEASE_SECONDS=360
